# Application deployed against an isolated Supabase staging project.
E2E_BASE_URL=https://bronly-staging.example.com

# Dedicated role accounts. Never reuse production users.
E2E_OWNER_EMAIL=owner-e2e@example.com
E2E_OWNER_PASSWORD=replace-me
E2E_AGENT_EMAIL=agent-e2e@example.com
E2E_AGENT_PASSWORD=replace-me
E2E_ADMIN_EMAIL=admin-e2e@example.com
E2E_ADMIN_PASSWORD=replace-me

# Stable fixture identifiers prepared in staging.
E2E_OWNER_PUBLIC_SLUG=owner-e2e
E2E_OWNER_ROOM_ID=00000000-0000-0000-0000-000000000000
E2E_OWNER_PROFILE_QUERY=Owner E2E
E2E_TEST_PROPERTY_QUERY=Property E2E
E2E_AGENT_PUBLIC_ID=ag_e2e001
E2E_GUEST_CHECK_IN=2026-11-10
E2E_GUEST_CHECK_OUT=2026-11-12

# Server-only staging access used to verify and remove the guest request.
E2E_SUPABASE_URL=https://your-staging-project.supabase.co
E2E_SUPABASE_ANON_KEY=replace-me-for-local-web-server
E2E_SUPABASE_SERVICE_ROLE_KEY=replace-me
E2E_ALLOW_MUTATIONS=false

# Optional: use an already running localhost server.
E2E_SKIP_WEB_SERVER=false
