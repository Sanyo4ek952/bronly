NEXT_PUBLIC_SUPABASE_URL=https://uevwqievuzakcquselku.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical app URL. Required for invite links, auth redirects, and notification links.
# On Vercel, set this to your stable production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Read-only demo data is enabled only when this flag is explicitly true.
BRONLY_DEMO_MODE=false
BRONLY_DEMO_PROPERTY_SLUG=dom-u-morya

# PWA push. Generate a VAPID key pair once and keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram bot delivery and webhook verification. Tokens and secrets are server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
